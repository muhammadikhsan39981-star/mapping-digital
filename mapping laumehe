
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Digital Mapping Gua Laumehe</title>

  <!-- Leaflet: peta interaktif -->
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  />

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: #06111e;
      color: #f1f5f9;
      line-height: 1.6;
    }

    header {
      padding: 20px 6%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #071827;
      border-bottom: 1px solid #164e63;
    }

    header h2 {
      color: #38bdf8;
      font-size: 22px;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 20px;
      font-size: 14px;
    }

    nav a:hover {
      color: #38bdf8;
    }

    .hero {
      padding: 70px 6%;
      min-height: 400px;
      display: flex;
      align-items: center;
      background:
        linear-gradient(
          90deg,
          rgba(2, 12, 27, .95),
          rgba(2, 12, 27, .65)
        ),
        url("images/gua-laumehe.png") center/cover;
    }

    .hero-content {
      max-width: 650px;
    }

    .hero small {
      color: #38bdf8;
      letter-spacing: 4px;
      font-weight: bold;
    }

    .hero h1 {
      font-size: clamp(35px, 6vw, 65px);
      line-height: 1.1;
      margin: 20px 0;
    }

    .hero p {
      color: #cbd5e1;
      margin-bottom: 25px;
    }

    .btn {
      display: inline-block;
      padding: 12px 22px;
      background: #0284c7;
      color: white;
      text-decoration: none;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      font-weight: bold;
    }

    .btn:hover {
      background: #0369a1;
    }

    section {
      padding: 55px 6%;
    }

    .section-title {
      font-size: 28px;
      margin-bottom: 10px;
    }

    .section-desc {
      color: #94a3b8;
      margin-bottom: 25px;
    }

    .info-grid {
      display: grid;
      grid-template-columns:
        repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
    }

    .card {
      background: #0c1e30;
      padding: 22px;
      border: 1px solid #164e63;
      border-radius: 14px;
    }

    .card h3 {
      color: #38bdf8;
      margin-bottom: 10px;
    }

    .card p {
      color: #cbd5e1;
      font-size: 14px;
    }

    .mapping-layout {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 25px;
    }

    #map {
      height: 500px;
      width: 100%;
      border-radius: 14px;
      border: 1px solid #164e63;
      z-index: 1;
    }

    .point-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .point {
      background: #0c1e30;
      padding: 16px;
      border-radius: 10px;
      border: 1px solid #164e63;
      cursor: pointer;
      transition: .2s;
    }

    .point:hover {
      background: #12314b;
      transform: translateX(4px);
    }

    .point h4 {
      color: #38bdf8;
      margin-bottom: 5px;
    }

    .point p {
      font-size: 13px;
      color: #cbd5e1;
    }

    .gallery {
      display: grid;
      grid-template-columns:
        repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
    }

    .gallery img {
      width: 100%;
      height: 190px;
      object-fit: cover;
      border-radius: 12px;
      border: 1px solid #164e63;
    }

    .gallery h3 {
      margin-top: 10px;
      color: #38bdf8;
    }

    .notice {
      background: #102a3f;
      border-left: 4px solid #38bdf8;
      padding: 20px;
      border-radius: 8px;
      color: #cbd5e1;
    }

    footer {
      text-align: center;
      padding: 25px;
      background: #071827;
      color: #94a3b8;
      font-size: 13px;
    }

    @media (max-width: 800px) {
      header {
        flex-direction: column;
        gap: 12px;
      }

      nav a {
        margin: 0 7px;
      }

      .mapping-layout {
        grid-template-columns: 1fr;
      }

      #map {
        height: 380px;
      }

      .hero {
        padding: 50px 6%;
      }
    }
  </style>
</head>

<body>

  <!-- HEADER -->
  <header>
    <h2>GUA LAUMEHE</h2>

    <nav>
      <a href="#beranda">Beranda</a>
      <a href="#tentang">Tentang</a>
      <a href="#mapping">Mapping</a>
      <a href="#galeri">Galeri</a>
    </nav>
  </header>

  <!-- BERANDA -->
  <section class="hero" id="beranda">
    <div class="hero-content">
      <small>DIGITAL TOURISM • MAWASANGKA TIMUR</small>

      <h1>Digital Mapping<br>Gua Laumehe</h1>

      <p>
        Jelajahi keindahan alam bawah tanah Gua Laumehe
        melalui peta digital interaktif. Temukan informasi
        lokasi, potensi wisata, dan keunikan formasi gua.
      </p>

      <a href="#mapping" class="btn">
        Jelajahi Peta
      </a>

      <a
        href="https://maps.app.goo.gl/vDmUEHpZiendNCtPA"
        target="_blank"
        rel="noopener"
        class="btn"
      >
        Google Maps
      </a>
    </div>
  </section>

  <!-- INFORMASI GUA -->
  <section id="tentang">
    <h2 class="section-title">Tentang Gua Laumehe</h2>

    <p class="section-desc">
      Informasi wisata dan potensi alam Gua Laumehe.
    </p>

    <div class="info-grid">

      <div class="card">
        <h3>Lokasi</h3>
        <p>
          Wantopi, Kecamatan Mawasangka Timur,
          Kabupaten Buton Tengah, Sulawesi Tenggara.
        </p>
      </div>

      <div class="card">
        <h3>Potensi Wisata</h3>
        <p>
          Wisata alam, eksplorasi gua, fotografi,
          edukasi geologi, dan konservasi lingkungan.
        </p>
      </div>

      <div class="card">
        <h3>Keunikan</h3>
        <p>
          Bentang alam bawah tanah dan potensi
          formasi batuan alami yang menarik untuk
          didokumentasikan.
        </p>
      </div>

    </div>
  </section>

  <!-- DIGITAL MAPPING -->
  <section id="mapping">
    <h2 class="section-title">Digital Mapping Interaktif</h2>

    <p class="section-desc">
      Klik penanda pada peta untuk melihat informasi lokasi.
    </p>

    <div class="mapping-layout">

      <div>
        <div id="map"></div>
      </div>

      <div class="point-list">

        <div class="point" onclick="showPoint(0)">
          <h4>01 — Lokasi Gua</h4>
          <p>
            Lokasi utama Gua Laumehe berdasarkan
            tautan Google Maps.
          </p>
        </div>

        <div class="point" onclick="showPoint(1)">
          <h4>02 — Pintu Masuk</h4>
          <p>
            Titik awal jalur pengunjung.
            Koordinat perlu disurvei di lapangan.
          </p>
        </div>

        <div class="point" onclick="showPoint(2)">
          <h4>03 — Area Eksplorasi</h4>
          <p>
            Area dokumentasi formasi batuan
            dan kondisi lingkungan gua.
          </p>
        </div>

        <div class="point" onclick="showPoint(3)">
          <h4>04 — Area Akhir</h4>
          <p>
            Titik eksplorasi lanjutan yang
            hanya ditambahkan setelah survei.
          </p>
        </div>

        <a
          href="https://maps.app.goo.gl/vDmUEHpZiendNCtPA"
          target="_blank"
          rel="noopener"
          class="btn"
        >
          Buka Lokasi di Google Maps
        </a>

      </div>
    </div>
  </section>

  <!-- GALERI -->
  <section id="galeri">
    <h2 class="section-title">Galeri Gua Laumehe</h2>

    <p class="section-desc">
      Dokumentasi visual lokasi dan lingkungan gua.
    </p>

    <div class="gallery">

      <div class="card">
        <img
          src="images/gua-laumehe.png"
          alt="Digital mapping Gua Laumehe"
        >
        <h3>Digital Mapping</h3>
        <p>Visualisasi awal peta wisata digital.</p>
      </div>

      <div class="card">
        <img
          src="images/gua-laumehe.png"
          alt="Visual wisata Gua Laumehe"
        >
        <h3>Wisata Alam</h3>
        <p>Dokumentasi potensi alam kawasan gua.</p>
      </div>

      <div class="card">
        <img
          src="images/gua-laumehe.png"
          alt="Pemetaan gua"
        >
        <h3>Eksplorasi</h3>
        <p>Informasi jalur dan titik eksplorasi.</p>
      </div>

    </div>
  </section>

  <!-- KONSERVASI -->
  <section>
    <div class="notice">
      <h3>Jaga Kelestarian Gua Laumehe</h3>
      <p>
        Jangan merusak formasi batuan, membuang sampah,
        atau memasuki area berbahaya tanpa pemandu.
        Data jalur dan titik di dalam gua harus
        diverifikasi melalui survei lapangan.
      </p>
    </div>
  </section>

  <footer>
    <p>
      Digital Mapping Gua Laumehe
      | Wantopi, Mawasangka Timur
    </p>
    <p>Proyek Digital Storytelling dan Wisata Alam</p>
  </footer>

  <!-- LEAFLET JS -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script>
    /*
      KOORDINAT LOKASI:
      Koordinat di bawah adalah contoh titik awal.
      Ganti dengan koordinat hasil survei atau
      pin lokasi yang sudah diverifikasi.
    */

    const caveLat = -5.389;
    const caveLng = 122.897;

    // Membuat peta
    const map = L.map("map").setView(
      [caveLat, caveLng],
      15
    );

    // Layer peta dasar
    L.tileLayer(
      "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
      {
        attribution:
          '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
      }
    ).addTo(map);

    // Data titik pemetaan
    // Titik 1-3 merupakan contoh ilustratif.
    const points = [
      {
        name: "Lokasi Gua Laumehe",
        lat: caveLat,
        lng: caveLng,
        description:
          "Lokasi utama berdasarkan titik awal contoh."
      },
      {
        name: "Pintu Masuk Gua",
        lat: caveLat + 0.0003,
        lng: caveLng + 0.0003,
        description:
          "Contoh titik pintu masuk. Perlu verifikasi lapangan."
      },
      {
        name: "Area Eksplorasi",
        lat: caveLat + 0.0006,
        lng: caveLng + 0.0005,
        description:
          "Contoh titik eksplorasi. Bukan jalur aktual."
      },
      {
        name: "Area Akhir",
        lat: caveLat + 0.0008,
        lng: caveLng + 0.0008,
        description:
          "Contoh titik akhir. Perlu survei dan validasi."
      }
    ];

    const markers = [];

    // Membuat marker untuk setiap titik
    points.forEach((point, index) => {

      const marker = L.marker([
        point.lat,
        point.lng
      ]).addTo(map);

      marker.bindPopup(`
        <h3>${point.name}</h3>
        <p>${point.description}</p>
        <small>
          ${point.lat.toFixed(6)},
          ${point.lng.toFixed(6)}
        </small>
      `);

      markers.push(marker);
    });

    // Fungsi ketika daftar titik diklik
    function showPoint(index) {
      const point = points[index];

      map.setView(
        [point.lat, point.lng],
        18
      );

      markers[index].openPopup();
    }
  </script>

</body>
</html>
